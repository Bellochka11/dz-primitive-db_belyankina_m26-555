[500.63273, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'help' - справочная информация\u001b[m\u001b[41m \u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[500.663627, "o", "\r\u001b[KREADME.md:31: trailing whitespace.\u001b[m\r\n:\u001b[K"]
