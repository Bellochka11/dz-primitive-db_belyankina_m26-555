[500.554204, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'exit' - выход из программы\u001b[m\u001b[41m \u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
