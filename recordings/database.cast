[502.205709, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.251383, "o", "\r\u001b[KREADME.md:55: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.282836, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32mhttps://asciinema.org/a/DxsHr4w6c5gaJhuS\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.312921, "o", "\r\u001b[KREADME.md:56: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.344387, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.375306, "o", "\r\u001b[KREADME.md:57: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.405726, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.437578, "o", "\r\u001b[KREADME.md:58: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.482676, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m## CRUD-операции\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.513586, "o", "\r\u001b[KREADME.md:59: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.545346, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32mПриложение поддерживает операции CRUD (Create, Read, Update, Delete): добавление, чтение, изменение и удаление записей.\u001b[m\u001b[41m\u001b[m \b:\u001b[K"]
[502.57655, "o", "\r\u001b[K\u001b[32m\u001b[m\u001b[32m\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.609477, "o", "\r\u001b[KREADME.md:60: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.639008, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32mДанные каждой таблицы хранятся в отдельном JSON-файле в каталоге data/. Метаданные таблиц хранятся в db_meta.json.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.670439, "o", "\r\u001b[KREADME.md:61: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.701528, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.733637, "o", "\r\u001b[KREADME.md:62: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.780112, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m### Описание команд\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.810271, "o", "\r\u001b[KREADME.md:63: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.84029, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'insert into <имя_таблицы> values (<значение1>, <значение2>, ...)' - создать запись.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.871527, "o", "\r\u001b[KREADME.md:64: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.902373, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'select from <имя_таблицы> where <столбец> = <значение>' - прочитать записи по условию.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[502.93309, "o", "\r\u001b[KREADME.md:65: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[502.963418, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'select from <имя_таблицы>' - прочитать все записи.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[503.010174, "o", "\r\u001b[KREADME.md:66: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[503.040723, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия>' - обновить запис\u001b[m \b:\u001b[K"]
[503.072384, "o", "\r\u001b[K\u001b[32m\u001b[m\u001b[32mь.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[503.10359, "o", "\r\u001b[KREADME.md:67: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[503.134486, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'delete from <имя_таблицы> where <столбец> = <значение>' - удалить запись.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[503.165271, "o", "\r\u001b[KREADME.md:68: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[503.196517, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'info <имя_таблицы>' - вывести информацию о таблице.\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[503.227747, "o", "\r\u001b[KREADME.md:69: trailing whitespace.\u001b[m\r\n:\u001b[K"]
[503.275175, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n"]
[503.275316, "o", ":\u001b[K"]
