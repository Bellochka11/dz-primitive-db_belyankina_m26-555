[725.239298, "o", "import json\r\nfrom pathlib import Path\r\n\r\nMETADATA_FILE = Path(\"db_meta.json\")\r\nDATA_DIR = Path(\"data\")\r\n\r\ndef load_metadata(filepath):\r\n    \"\"\"Load database metadata from a JSON file.\"\"\"\r\n    try:\r\n        with open(filepath, \"r\", encoding=\"utf-8\") as file:\r\n            return json.load(file)\r\n    except FileNotFoundError:\r\n        return {}\r\n\r\n\r\ndef save_metadata(filepath, data):\r\n    \"\"\"Save database metadata to a JSON file.\"\"\"\r\n    filepath = Path(filepath)\r\n    filepath.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(filepath, \"w\", encoding=\"utf-8\") as file:\r\n        json.dump(data, file, ensure_ascii=False, indent=4)\r\n\r\n\r\ndef load_table_data(table_name):\r\n    \"\"\"Загружает данные таблицы из JSON-файла.\"\"\"\r\n    filepath = DATA_DIR / f\"{table_name}.json\"\r\n    try:\r\n        with open(filepath, \"r\", encoding=\"utf-8\") as file:\r\n            return json.load(file)\r\n    except FileNotFoundError:\r\n        return []\r\n\r\n\r\ndef save_table_data(table_name, data):\r\n    \"\"\"Сохра"]
[725.239414, "o", "няет данные таблицы в JSON-файл.\"\"\"\r\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\r\n    filepath = DATA_DIR / f\"{table_name}.json\"\r\n    with open(filepath, \"w\", encoding=\"utf-8\") as file:\r\n"]
[725.24006, "o", "        json.dump(data, file, ensure_ascii=False, indent=4)"]
