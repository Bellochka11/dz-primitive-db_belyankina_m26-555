[500.492053, "o", "\r\u001b[K\u001b[32m+\u001b[m\u001b[32m'drop_table <имя_таблицы>' - yдалить таблицу\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
