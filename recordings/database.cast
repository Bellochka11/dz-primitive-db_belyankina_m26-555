[500.070742, "o", "\u001b[32m+\u001b[m\u001b[32m## Управление таблицами\u001b[m\u001b[41m\u001b[7m^M\u001b[27m\u001b[m\u001b[m\r\n:\u001b[K"]
[500.101609, "o", "\r\u001b[KREADME.md:23: trailing whitespace.\u001b[m\r\n:\u001b[K"]
