[0.017467, "o", "\u001b[?2004h\u001b]0;liza@DESKTOP-G4GQU63: /mnt/c/projects/dz-primitive-db_belyankina_m26-555\u0007\u001b[01;32mliza@DESKTOP-G4GQU63\u001b[00m:\u001b[01;34m/mnt/c/projects/dz-primitive-db_belyankina_m26-555\u001b[00m$ "]
[4.34586, "o", "\u001b[7muv run database\u001b[27m"]
[4.65776, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\buv run database\r\n\u001b[?2004l\r"]
[5.049308, "o", "\r\n*** Процесс работы с таблицами ***\r\nФункции:\r\ncreate_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\nlist_tables - показать список всех таблиц\r\ndrop_table <имя_таблицы> - удалить таблицу\r\n\r\n*** Операции с данными ***\r\nФункции:\r\ninsert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\nselect from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\nselect from <имя_таблицы> - прочитать все записи.\r\nupdate <имя_таблицы> set <столбец> = <новое_значение> where <столбец_условия> = <значение_условия> - обновить запись.\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\ninfo <"]
[5.049481, "o", "имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\nexit - выход из программы\r\nhelp - справочная информация\r\n\r\n"]
[5.049699, "o", "Введите команду: "]
[7.725087, "o", "help"]
[7.989685, "o", "\r\n"]
[7.989809, "o", "\r\n*** Процесс работы с таблицами ***\r\nФункции:\r\ncreate_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\nlist_tables - показать список всех таблиц\r\ndrop_table <имя_таблицы> - удалить таблицу\r\n\r\n*** Операции с данными ***\r\nФункции:\r\ninsert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\nselect from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\nselect from <имя_таблицы> - прочитать все записи.\r\nupdate <имя_таблицы> set <столбец> = <новое_значение> where <столбец_условия> = <значение_условия> - обновить запись.\r\ndelete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\ninfo <"]
[7.98984, "o", "имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\nexit - выход из программы\r\nhelp - справочная информация\r\n\r\n"]
[7.989876, "o", "Введите команду: "]
[11.998274, "o", "create_table demo_users name:str"]
[11.998569, "o", " age:int"]
[12.192652, "o", "\r\n"]
[12.194634, "o", "Таблица \"demo_users\" успешно создана со столбцами: ID:int, name:str, age:int\r\n"]
[12.196746, "o", "Введите команду: "]
